/* 全局超大字体 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  background-color: #f5f7fa;
  height: 100%;
}

button, text, view, input {
  font-size: 60rpx;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  line-height: normal;
  height: auto;
  min-height: auto;
}

button::after {
  border: none;
}

.container {
  min-height: 100vh;
  padding: 60rpx;
  box-sizing: border-box;
}

/* 输入框样式 */
.input-group {
  margin-bottom: 60rpx;
}

.input-label {
  font-size: 60rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
  font-weight: bold;
}

.input-field {
  width: 100%;
  height: 140rpx;
  background: #fff;
  border: 4rpx solid #ddd;
  border-radius: 40rpx;
  padding: 0 40rpx;
  font-size: 60rpx;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #FF6B4A;
}

/* 按钮样式 */
.btn-primary {
  width: 100%;
  height: 140rpx;
  background: #FF6B4A;
  color: #fff;
  font-size: 70rpx;
  font-weight: bold;
  border-radius: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 20rpx 40rpx rgba(255, 107, 74, 0.3);
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary {
  width: 100%;
  height: 120rpx;
  background: transparent;
  color: #666;
  font-size: 60rpx;
  border: 4rpx solid #ddd;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.btn-secondary:active {
  background: #f5f5f5;
}

/* 链接样式 */
.link-row {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
}

.link-text {
  color: #FF6B4A;
  font-size: 55rpx;
  text-decoration: underline;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 60rpx;
  padding: 60rpx;
  margin-bottom: 50rpx;
  box-shadow: 0 30rpx 60rpx rgba(0, 0, 0, 0.1);
}

.card-title {
  font-size: 70rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
  border-left: 12rpx solid #FF6B4A;
  padding-left: 30rpx;
}

/* 空状态 */
.empty-box {
  background: #f8f9fa;
  border-radius: 40rpx;
  padding: 100rpx;
  text-align: center;
}

.empty-text {
  font-size: 60rpx;
  color: #999;
}